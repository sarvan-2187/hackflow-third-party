# Copy to .env (git ignores it). Everything here can also be a real env var.

# Where HackFlow runs, as this app sees it.
HACKFLOW_URL=http://localhost:8000

# An organizer's API key: HackFlow > Integrations > Create key. Shown once.
HACKFLOW_API_KEY=hf_paste_your_key_here

# Which event to follow (the number in /api/events/{id}); defaults to the first.
HACKFLOW_EVENT_ID=

# Where HackFlow should POST webhooks, i.e. this app as HackFlow can reach it.
# HackFlow in Docker, this app on the host:  http://host.docker.internal:4000
# A public deployment:                        https://relay.example.com
PUBLIC_URL=http://host.docker.internal:4000

PORT=4000

# Optional HTTP basic-auth password for the dashboard (any username).
DASHBOARD_PASSWORD=
